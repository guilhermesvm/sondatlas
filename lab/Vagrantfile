# VM Debian com a Software Probe oficial do RIPE Atlas.
#
# A VM entra na rede local em bridge (pela placa que acessa a internet), para
# a probe medir pelo mesmo caminho dos outros aparelhos da rede. A placa NAT
# continua existindo só para o Vagrant gerenciar a VM.
#
# A probe é instalada, mas só é ativada depois do cadastro manual no site do RIPE.

VM_NAME = "kit-ripe-atlas-probe"

# Placa escolhida no primeiro "vagrant up": o VirtualBox a guarda na própria VM.
# Sem VM (primeira instalação ou após destroy) ou se a consulta falhar, devolve
# nil e o Vagrant pergunta qual placa usar.
def saved_bridge
  id_file = File.join(File.dirname(__FILE__), ".vagrant", "machines", "default", "virtualbox", "id")
  return nil unless File.exist?(id_file)

  vboxmanage = File.join(ENV.fetch("VBOX_MSI_INSTALL_PATH", ""), "VBoxManage")
  vboxmanage = "VBoxManage" unless ENV["VBOX_MSI_INSTALL_PATH"]
  info = IO.popen([vboxmanage, "showvminfo", File.read(id_file).strip, "--machinereadable"],
                  err: File::NULL, &:read)
  info[/^bridgeadapter2="(.+)"$/, 1]
rescue SystemCallError
  nil
end

# Placa física pela qual o computador sai para a internet (rota padrão; com
# cabo e Wi-Fi, a de menor métrica). VPN e vEthernet não são físicas e ficam
# de fora. Sem resposta, ou se o VirtualBox não conhecer o nome, o Vagrant
# pergunta qual placa usar.
def internet_bridge
  name = if Vagrant::Util::Platform.windows?
    IO.popen(["powershell", "-NoProfile", "-Command",
              "Get-NetRoute -DestinationPrefix 0.0.0.0/0 | " \
              "Sort-Object { $_.RouteMetric + (Get-NetIPInterface -InterfaceIndex $_.ifIndex -AddressFamily IPv4).InterfaceMetric } | " \
              "ForEach-Object { Get-NetAdapter -InterfaceIndex $_.ifIndex } | Where-Object HardwareInterface | " \
              "Select-Object -First 1 -ExpandProperty InterfaceDescription"],
             err: File::NULL, &:read).strip
  else
    IO.popen(["ip", "-o", "route", "get", "1.1.1.1"], err: File::NULL, &:read)[/ dev (\S+)/, 1]
  end
  name unless name.to_s.empty?
rescue SystemCallError
  nil
end

Vagrant.configure("2") do |config|
  # Não há box oficial do Debian para VirtualBox; o Bento a constrói a partir da
  # ISO oficial. Versão fixada para que todos partam do mesmo disco.
  config.vm.box = "bento/debian-13"
  config.vm.box_version = "202510.26.0"
  config.vm.box_check_update = false

  config.vm.hostname = VM_NAME
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # Sem "bridge:", o Vagrant lista as placas desta máquina e pergunta qual usar.
  bridge = saved_bridge || internet_bridge
  if bridge
    config.vm.network "public_network", bridge: bridge
  else
    config.vm.network "public_network"
  end

  config.vm.provider "virtualbox" do |vb|
    vb.name = VM_NAME
    vb.memory = 1024
    vb.cpus = 1
    # A box liga a tela remota (VRDE); a probe não precisa dela.
    vb.customize ["modifyvm", :id, "--vrde", "off"]
    # Pela placa NAT, a VM alcançaria os serviços do computador em 127.0.0.1
    # (10.0.2.2), como a API da Sondatlas. O SSH do Vagrant vai no sentido
    # contrário e continua funcionando.
    vb.customize ["modifyvm", :id, "--nat-localhostreachable1", "off"]
  end

  # Fuso deste computador no formato POSIX (sinal invertido: UTC-3 vira
  # "<-0300>3:00"), só para os horários das mensagens; a VM continua em UTC.
  off = Time.now.utc_offset
  hh_mm = format("%d:%02d", off.abs / 3600, off.abs % 3600 / 60)
  host_tz = format("<%s%s>%s%s", off < 0 ? "-" : "+", hh_mm.delete(":").rjust(4, "0"), off > 0 ? "-" : "", hh_mm)

  # Rodam nesta ordem: preparar a VM e depois instalar a probe.
  config.vm.provision "shell", path: "prepare-vm.sh", env: { "TZ" => host_tz }
  config.vm.provision "shell", path: "install-probe.sh", env: { "KIT_VAGRANT" => "1", "TZ" => host_tz }
end
