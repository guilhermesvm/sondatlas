# Optional with Docker Compose: it works without a .env file.
# Needed to run the pipeline or the API on the host (.venv).
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=network-measurement-platform
INFLUXDB_BUCKET=network-measurement-platform
# Host only: copy the token generated by Compose with
# docker compose exec api cat /run/kit-secrets/influxdb-token
# INFLUXDB_TOKEN=
POLLING_INTERVAL_SECONDS=60
# Ports on this computer; uncomment and change one if it is already in use
# WEB_PORT=8088
# API_PORT=8000
# INFLUXDB_PORT=8086
